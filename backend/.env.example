# Configuración de Base de Datos para TicketFlow Backend (Node.js)
# Para conectarse a Microsoft SQL Server local, definí las siguientes variables de entorno:

# DB_DIALECT=mssql
# DB_HOST=localhost
# DB_PORT=1433
# DB_NAME=TicketFlow_DB
# DB_USER=sa
# DB_PASSWORD=TuPassword123
# DB_TRUST_SERVER_CERTIFICATE=true
# DB_ENCRYPT=false
# DB_INSTANCE_NAME=SQLEXPRESS  # Descomentar si usás la instancia SQLEXPRESS

# Si no definís estas variables, la aplicación utilizará automáticamente SQLite local (ticketflow.sqlite).
